# 本地 ark-iam 联调配置
# 使用：cp .env.ark-iam.example .env.ark-iam.local，然后填写 ARK_DIRECTORY_API_KEY
# 该文件按 Makefile 的 KEY=value 语法解析，不要写 export。

# ark-iam 仓库路径（可写绝对路径）
ARK_IAM_DIR=../ark-iam

# gateway / login-web 端口
ARK_GATEWAY_PORT=8100
ARK_LOGIN_PORT=4000

# 浏览器 OIDC 走 gateway（login-web 的 /oidc 代理到 8100）
ARK_OIDC_ISSUER=http://localhost:8100/oidc
ARK_DIRECTORY_BASE_URL=http://localhost:8100/v1/rp/directory
ARK_DIRECTORY_TOKEN_URL=http://localhost:8100/oidc/oauth/token
ARK_DIRECTORY_RESOURCE=rpapi

# 本地 ark-iam API Key；不要提交真实值
ARK_DIRECTORY_API_KEY=REPLACE_WITH_LOCAL_API_KEY
ARK_DIRECTORY_API_KEY_HEADER=true
